# This file is documentation only; the application does not load .env files.
COPILOT_MODE=offline
COPILOT_DB=.data/copilot.db
# For explicit real-provider mode, export these variables in your shell:
# COPILOT_MODE=qwen
# DASHSCOPE_API_KEY=your-own-key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_EMBEDDING_MODEL=text-embedding-v4
# COPILOT_RERANKER=lexical
# Optional Qwen listwise reranking uses an extra chat-completions call:
# COPILOT_RERANKER=qwen
